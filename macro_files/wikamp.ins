--- requires "subject" variable to be initialized with the subject URL
> detect_if_firefox_open
    --- Hardcoded section for now
    detect firefox_minimized.png --section 570,1020,1000,60 --click left
    jump -if -to open_new_tab
> open_firefox
    command open_firefox
    await firefox_open.png --section 570,1020,1000,60 --click left
    jump -if -to firefox_ready
    end
> open_new_tab
    0.2 tap t --with_ctrl
> firefox_ready
    command copy https://login.p.lodz.pl/login?service=https%3A%2F%2Fedu.p.lodz.pl%2Flogin%2Findex.php%3FauthCAS%3DCAS
    0.2 tap e --with_ctrl
    0.03 tap backspace
    0.03 tap v --with_ctrl
    0.03 tap enter
    await cas_open.png
    jump -if -to log_in
    match wikamp_open.png
    jump -if -to go_to_subject
    end
> log_in
    0.5 tap down
    0.1 tap enter
    0.1 tap enter
    0.5 await firefox_loading_website.png
    jump -if -by 1
    end
> go_to_subject
    command is_variable_initialized subject --pass_variables --pass_interpreter
    jump -if -by 1
    end
    command copy_variable subject --pass_variables
    tap e --with_ctrl
    0.03 tap backspace
    0.03 tap v --with_ctrl
    0.03 tap enter